{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "label": "C/C++: build current example",
      "command": "/usr/bin/clang++ -std=c++17 -fcolor-diagnostics -fansi-escape-codes -Wall -g \"${file}\" $(ls *.cpp | grep -v '^example') -o \"${fileBasenameNoExtension}\"",
      "options": {
        "cwd": "${fileDirname}"
      },
      "problemMatcher": ["$gcc"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "detail": "編譯目前的 example 檔 + 資料夾中非 example 開頭的 .cpp"
    }
  ]
}
